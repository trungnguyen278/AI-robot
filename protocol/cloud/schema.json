{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Robot-cloud link, version 2.0",
  "description": "Every message of protocol/cloud/README.md, each sent as one text stream on the topic ai-robot. Validate a message from the robot against #/$defs/from_robot, one from the cloud against #/$defs/from_cloud. Unknown message types and fields are allowed, so that newer minor versions can add them.",
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64},
    "time": {"type": "number", "minimum": 0, "description": "Unix seconds on the sender's clock"},
    "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "short_text": {"type": "string", "maxLength": 256},
    "json_schema": {"type": "object", "description": "A JSON Schema, 2020-12 unless it says otherwise"},
    "version": {"type": "string", "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}$"},

    "message": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {"type": "string", "minLength": 1, "maxLength": 64},
        "id": {"$ref": "#/$defs/id"},
        "reply_to": {"$ref": "#/$defs/id"}
      }
    },

    "event_kind": {
      "type": "object",
      "required": ["name", "description", "schema"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "description": {"type": "string", "maxLength": 1024},
        "schema": {"$ref": "#/$defs/json_schema"}
      }
    },

    "robot_hello": {
      "required": ["protocol", "software", "time", "utc_offset", "conversations", "events"],
      "properties": {
        "protocol": {"$ref": "#/$defs/version"},
        "software": {"type": "string", "minLength": 1, "maxLength": 64},
        "time": {"$ref": "#/$defs/time"},
        "utc_offset": {"type": "integer", "minimum": -1440, "maximum": 1440, "description": "Minutes"},
        "conversations": {"type": "boolean", "description": "The robot publishes its microphone for turns and plays the agent's voice"},
        "events": {"type": "array", "items": {"$ref": "#/$defs/event_kind"}, "maxItems": 256}
      }
    },
    "cloud_hello": {
      "required": ["reply_to", "protocol", "session", "time", "conversations", "events"],
      "properties": {
        "protocol": {"$ref": "#/$defs/version"},
        "session": {
          "type": "object",
          "required": ["id"],
          "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 128}}
        },
        "time": {"$ref": "#/$defs/time"},
        "conversations": {"type": "boolean", "description": "The agent takes turns and answers with its voice"},
        "events": {"type": "array", "items": {"$ref": "#/$defs/name"}, "maxItems": 256}
      }
    },
    "mcp": {
      "required": ["payload"],
      "properties": {
        "payload": {
          "type": "object",
          "required": ["jsonrpc"],
          "properties": {"jsonrpc": {"const": "2.0"}},
          "description": "One MCP JSON-RPC message, revision 2026-07-28"
        }
      }
    },
    "event": {
      "required": ["name", "time", "data"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "time": {"$ref": "#/$defs/time"},
        "data": {"type": "object"}
      }
    },
    "turn_start": {
      "required": ["turn", "trigger", "context"],
      "properties": {
        "turn": {"$ref": "#/$defs/id"},
        "trigger": {"type": "string", "minLength": 1, "maxLength": 32, "description": "wake_word, tap, button, follow_up or barge_in"},
        "context": {
          "type": "object",
          "properties": {
            "battery": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
            "charging": {"type": ["boolean", "null"]}
          }
        }
      }
    },
    "turn": {
      "required": ["turn"],
      "properties": {"turn": {"$ref": "#/$defs/id"}, "reason": {"$ref": "#/$defs/short_text"}}
    },
    "robot_speech_end": {
      "required": ["turn", "speech_ms"],
      "properties": {
        "turn": {"$ref": "#/$defs/id"},
        "speech_ms": {"type": "integer", "minimum": 0, "description": "How much speech the robot sent in the turn"}
      }
    },
    "response_start": {
      "required": ["response", "turn"],
      "properties": {
        "response": {"$ref": "#/$defs/id"},
        "turn": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      }
    },
    "response_text": {
      "required": ["response", "delta"],
      "properties": {"response": {"$ref": "#/$defs/id"}, "delta": {"type": "string", "maxLength": 4096}}
    },
    "response_end": {
      "required": ["response", "follow_up"],
      "properties": {"response": {"$ref": "#/$defs/id"}, "follow_up": {"type": "boolean"}}
    },
    "response": {
      "required": ["response"],
      "properties": {"response": {"$ref": "#/$defs/id"}}
    },
    "error": {
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 64},
        "message": {"type": "string", "maxLength": 1024}
      }
    },
    "bye": {
      "required": ["reason"],
      "properties": {"reason": {"$ref": "#/$defs/short_text"}}
    },

    "from_robot": {
      "$ref": "#/$defs/message",
      "allOf": [
        {"if": {"$ref": "#/$defs/is_hello"}, "then": {"$ref": "#/$defs/robot_hello"}},
        {"if": {"$ref": "#/$defs/is_mcp"}, "then": {"$ref": "#/$defs/mcp"}},
        {"if": {"$ref": "#/$defs/is_event"}, "then": {"$ref": "#/$defs/event"}},
        {"if": {"$ref": "#/$defs/is_turn_start"}, "then": {"$ref": "#/$defs/turn_start"}},
        {"if": {"$ref": "#/$defs/is_turn_speech_end"}, "then": {"$ref": "#/$defs/robot_speech_end"}},
        {"if": {"$ref": "#/$defs/is_turn_cancel"}, "then": {"$ref": "#/$defs/turn"}},
        {"if": {"$ref": "#/$defs/is_response_interrupted"}, "then": {"$ref": "#/$defs/response"}},
        {"if": {"$ref": "#/$defs/is_error"}, "then": {"$ref": "#/$defs/error"}},
        {"if": {"$ref": "#/$defs/is_bye"}, "then": {"$ref": "#/$defs/bye"}}
      ]
    },
    "from_cloud": {
      "$ref": "#/$defs/message",
      "allOf": [
        {"if": {"$ref": "#/$defs/is_hello"}, "then": {"$ref": "#/$defs/cloud_hello"}},
        {"if": {"$ref": "#/$defs/is_mcp"}, "then": {"$ref": "#/$defs/mcp"}},
        {"if": {"$ref": "#/$defs/is_turn_speech_end"}, "then": {"$ref": "#/$defs/turn"}},
        {"if": {"$ref": "#/$defs/is_turn_cancel"}, "then": {"$ref": "#/$defs/turn"}},
        {"if": {"$ref": "#/$defs/is_response_start"}, "then": {"$ref": "#/$defs/response_start"}},
        {"if": {"$ref": "#/$defs/is_response_text"}, "then": {"$ref": "#/$defs/response_text"}},
        {"if": {"$ref": "#/$defs/is_response_end"}, "then": {"$ref": "#/$defs/response_end"}},
        {"if": {"$ref": "#/$defs/is_response_stop"}, "then": {"$ref": "#/$defs/response"}},
        {"if": {"$ref": "#/$defs/is_error"}, "then": {"$ref": "#/$defs/error"}},
        {"if": {"$ref": "#/$defs/is_bye"}, "then": {"$ref": "#/$defs/bye"}}
      ]
    },

    "is_hello": {"required": ["type"], "properties": {"type": {"const": "hello"}}},
    "is_mcp": {"required": ["type"], "properties": {"type": {"const": "mcp"}}},
    "is_event": {"required": ["type"], "properties": {"type": {"const": "event"}}},
    "is_turn_start": {"required": ["type"], "properties": {"type": {"const": "turn.start"}}},
    "is_turn_speech_end": {"required": ["type"], "properties": {"type": {"const": "turn.speech_end"}}},
    "is_turn_cancel": {"required": ["type"], "properties": {"type": {"const": "turn.cancel"}}},
    "is_response_start": {"required": ["type"], "properties": {"type": {"const": "response.start"}}},
    "is_response_text": {"required": ["type"], "properties": {"type": {"const": "response.text"}}},
    "is_response_end": {"required": ["type"], "properties": {"type": {"const": "response.end"}}},
    "is_response_stop": {"required": ["type"], "properties": {"type": {"const": "response.stop"}}},
    "is_response_interrupted": {"required": ["type"], "properties": {"type": {"const": "response.interrupted"}}},
    "is_error": {"required": ["type"], "properties": {"type": {"const": "error"}}},
    "is_bye": {"required": ["type"], "properties": {"type": {"const": "bye"}}}
  }
}
