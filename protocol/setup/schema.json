{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Set-up, the app and the robot over Bluetooth LE, version 1.0",
  "description": "Every message of the set-up protocol, as its JSON (README.md). from_app and from_robot are the messages of each side, in the clear or, after the exchange, once decrypted.",
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64},
    "version": {"type": "string", "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}$"},
    "discriminator": {"type": "string", "pattern": "^[0-9A-F]{4}$"},
    "salt": {"description": "16 bytes, base64url without padding", "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$"},
    "point": {"description": "A P-256 point in SEC1's uncompressed form, 65 bytes, base64url without padding", "type": "string", "pattern": "^[A-Za-z0-9_-]{87}$"},
    "tag": {"description": "An HMAC-SHA256 tag, 32 bytes, base64url without padding", "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "ssid": {"description": "A network's name, 1 to 32 bytes in UTF-8", "type": "string", "minLength": 1, "maxLength": 32},
    "ssid_hex": {"description": "A network's name whose bytes are not UTF-8, in hexadecimal", "type": "string", "pattern": "^([0-9a-f]{2}){1,32}$"},
    "named": {
      "description": "Exactly one of ssid and ssid_hex",
      "oneOf": [
        {"required": ["ssid"], "not": {"required": ["ssid_hex"]}},
        {"required": ["ssid_hex"], "not": {"required": ["ssid"]}}
      ]
    },
    "security": {"enum": ["open", "wpa2", "wpa3", "other"]},
    "network": {
      "description": "A network the robot sees",
      "type": "object",
      "allOf": [{"$ref": "#/$defs/named"}],
      "required": ["security", "signal", "saved"],
      "properties": {
        "ssid": {"$ref": "#/$defs/ssid"},
        "ssid_hex": {"$ref": "#/$defs/ssid_hex"},
        "security": {"$ref": "#/$defs/security"},
        "signal": {"type": "integer", "minimum": 0, "maximum": 100},
        "saved": {"type": "boolean"}
      }
    },
    "network_status": {
      "description": "The network the robot is on",
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": {"enum": ["connected", "connecting", "disconnected"]},
        "ssid": {"$ref": "#/$defs/ssid"},
        "ssid_hex": {"$ref": "#/$defs/ssid_hex"},
        "address": {"type": "string", "minLength": 2, "maxLength": 45},
        "internet": {"type": ["boolean", "null"]}
      },
      "if": {"properties": {"state": {"const": "connected"}}},
      "then": {"allOf": [{"$ref": "#/$defs/named"}], "required": ["address", "internet"]}
    },
    "message": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {"type": "string", "minLength": 1, "maxLength": 64},
        "id": {"$ref": "#/$defs/id"},
        "reply_to": {"$ref": "#/$defs/id"}
      }
    },
    "answer": {"required": ["reply_to"]},

    "app_hello": {"required": ["protocol"], "properties": {"protocol": {"$ref": "#/$defs/version"}}},
    "robot_hello": {
      "allOf": [{"$ref": "#/$defs/answer"}],
      "required": ["protocol", "discriminator", "salt"],
      "properties": {
        "protocol": {"$ref": "#/$defs/version"},
        "discriminator": {"$ref": "#/$defs/discriminator"},
        "salt": {"$ref": "#/$defs/salt"}
      }
    },
    "app_share": {"required": ["share"], "properties": {"share": {"$ref": "#/$defs/point"}}},
    "robot_share": {
      "allOf": [{"$ref": "#/$defs/answer"}],
      "required": ["share", "confirm"],
      "properties": {"share": {"$ref": "#/$defs/point"}, "confirm": {"$ref": "#/$defs/tag"}}
    },
    "confirm": {"required": ["confirm"], "properties": {"confirm": {"$ref": "#/$defs/tag"}}},
    "join": {
      "allOf": [{"$ref": "#/$defs/named"}],
      "properties": {
        "ssid": {"$ref": "#/$defs/ssid"},
        "ssid_hex": {"$ref": "#/$defs/ssid_hex"},
        "password": {"type": "string", "minLength": 1, "maxLength": 128},
        "hidden": {"type": "boolean"},
        "security": {"enum": ["open", "wpa2", "wpa3"]}
      },
      "if": {"required": ["hidden"], "properties": {"hidden": {"const": true}}},
      "then": {"required": ["security"]}
    },
    "register": {
      "required": ["challenge", "server"],
      "properties": {
        "challenge": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
        "server": {"type": "string", "pattern": "^https?://", "maxLength": 2048}
      }
    },
    "info": {
      "allOf": [{"$ref": "#/$defs/answer"}],
      "required": ["robot", "bound", "network"],
      "properties": {
        "robot": {
          "type": "object",
          "required": ["id", "name", "software"],
          "properties": {
            "id": {"type": "string", "minLength": 1, "maxLength": 64},
            "name": {"type": "string", "minLength": 1, "maxLength": 64},
            "software": {"type": "string", "minLength": 1, "maxLength": 64}
          }
        },
        "bound": {"type": "boolean"},
        "network": {"$ref": "#/$defs/network_status"}
      }
    },
    "networks": {
      "allOf": [{"$ref": "#/$defs/answer"}],
      "required": ["networks"],
      "properties": {"networks": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/network"}}}
    },
    "joined": {"allOf": [{"$ref": "#/$defs/answer"}], "required": ["network"], "properties": {"network": {"$ref": "#/$defs/network_status"}}},
    "registration": {
      "allOf": [{"$ref": "#/$defs/answer"}],
      "required": ["registration"],
      "properties": {"registration": {"type": "string", "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$", "maxLength": 4096}}
    },
    "error": {
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z_]{1,32}$"},
        "message": {"type": "string", "maxLength": 256}
      }
    },

    "is_hello": {"required": ["type"], "properties": {"type": {"const": "hello"}}},
    "is_share": {"required": ["type"], "properties": {"type": {"const": "share"}}},
    "is_confirm": {"required": ["type"], "properties": {"type": {"const": "confirm"}}},
    "is_info": {"required": ["type"], "properties": {"type": {"const": "info"}}},
    "is_networks": {"required": ["type"], "properties": {"type": {"const": "networks"}}},
    "is_join": {"required": ["type"], "properties": {"type": {"const": "join"}}},
    "is_joined": {"required": ["type"], "properties": {"type": {"const": "joined"}}},
    "is_register": {"required": ["type"], "properties": {"type": {"const": "register"}}},
    "is_registration": {"required": ["type"], "properties": {"type": {"const": "registration"}}},
    "is_finished": {"required": ["type"], "properties": {"type": {"const": "finished"}}},
    "is_error": {"required": ["type"], "properties": {"type": {"const": "error"}}},

    "from_app": {
      "$ref": "#/$defs/message",
      "allOf": [
        {"if": {"$ref": "#/$defs/is_hello"}, "then": {"$ref": "#/$defs/app_hello"}},
        {"if": {"$ref": "#/$defs/is_share"}, "then": {"$ref": "#/$defs/app_share"}},
        {"if": {"$ref": "#/$defs/is_confirm"}, "then": {"$ref": "#/$defs/confirm"}},
        {"if": {"$ref": "#/$defs/is_join"}, "then": {"$ref": "#/$defs/join"}},
        {"if": {"$ref": "#/$defs/is_register"}, "then": {"$ref": "#/$defs/register"}},
        {"if": {"$ref": "#/$defs/is_error"}, "then": {"$ref": "#/$defs/error"}}
      ]
    },
    "from_robot": {
      "$ref": "#/$defs/message",
      "allOf": [
        {"if": {"$ref": "#/$defs/is_hello"}, "then": {"$ref": "#/$defs/robot_hello"}},
        {"if": {"$ref": "#/$defs/is_share"}, "then": {"$ref": "#/$defs/robot_share"}},
        {"if": {"$ref": "#/$defs/is_info"}, "then": {"$ref": "#/$defs/info"}},
        {"if": {"$ref": "#/$defs/is_networks"}, "then": {"$ref": "#/$defs/networks"}},
        {"if": {"$ref": "#/$defs/is_joined"}, "then": {"$ref": "#/$defs/joined"}},
        {"if": {"$ref": "#/$defs/is_registration"}, "then": {"$ref": "#/$defs/registration"}},
        {"if": {"$ref": "#/$defs/is_finished"}, "then": {"$ref": "#/$defs/answer"}},
        {"if": {"$ref": "#/$defs/is_error"}, "then": {"$ref": "#/$defs/error"}}
      ]
    }
  }
}
