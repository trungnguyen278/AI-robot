# Environment variables read by ai-robot. All are optional: set them in your shell or,
# on the robot, in the service's environment (for example with EnvironmentFile= in a
# systemd unit). Command-line options take precedence.

# Configuration profile (config/profiles/<name>.toml). Default: desktop.
AI_ROBOT_PROFILE=desktop

# Configuration directory. Default: software/config in this checkout.
# AI_ROBOT_CONFIG_DIR=

# The robot's own protocols (protocol/ in this checkout). Default: the checkout's.
# AI_ROBOT_PROTOCOL_DIR=

# The protocols it shares with the cloud and the app: ai-platform's protocols/, pinned at
# platform/ in this checkout. Default: the checkout's.
# AI_ROBOT_PLATFORM_DIR=
